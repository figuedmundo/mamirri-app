generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  role              String             @default("THERAPIST")
  createdAt         DateTime           @default(now())
  pinHash           String?
  phone             String?
  profilePhotoUrl   String?
  clinicName        String?
  licenseNumber     String?
  specialty         String?
  yearsExperience   Int?
  patients          Patient[]
  sessions          Session[]
  treatmentSessions TreatmentSession[]

  @@index([email])
  @@map("users")
}

model Patient {
  id                    String         @id @default(cuid())
  email                 String?
  therapistId           String
  deletedAt             DateTime?
  birthDate             DateTime
  createdAt             DateTime       @default(now())
  gender                String?
  isActive              Boolean        @default(true)
  name                  String
  occupation            String
  phone                 String
  previousOccupation    String?
  emergencyContact      Json?
  medicalFlags          String[]
  referralSource        String?
  medicalFlagsOther     String?
  referralSourceDetails String?
  clinicalCases         ClinicalCase[]
  therapist             User           @relation(fields: [therapistId], references: [id])
  sessions              Session[]

  @@index([name])
  @@map("patients")
}

model ClinicalCase {
  id                      String             @id @default(cuid())
  patientId               String
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  consultationReason      String
  endDate                 DateTime?
  initialMedicalDiagnosis String?
  pathologicalHistory     Json?
  pharmacologicalHistory  String?
  startDate               DateTime
  status                  String
  title                   String
  patient                 Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  evaluations             Evaluation[]
  insoles                 Insole[]
  treatmentPlan           TreatmentPlan?
  treatmentSessions       TreatmentSession[]

  @@map("clinical_cases")
}

model Evaluation {
  id              String         @id @default(cuid())
  clinicalCaseId  String
  avdEvaluation   Json
  date            DateTime
  diagnosis       Json
  orthopedicTests Json
  painScale       Json
  posturogram     Json
  voiceNotes      Json?
  type            String
  clinicalCase    ClinicalCase   @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)
  footprints      Footprint[]
  postureVideos   PostureVideo[]

  @@map("evaluations")
}

model TreatmentPlan {
  id             String       @id @default(cuid())
  clinicalCaseId String       @unique
  createdAt      DateTime     @default(now())
  insoleSnapshot Json?
  objectives     Json
  phases         Json
  clinicalCase   ClinicalCase @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)

  @@map("treatment_plans")
}

model TreatmentSession {
  id              String         @id @default(cuid())
  clinicalCaseId  String
  therapistId     String
  createdAt       DateTime       @default(now())
  date            DateTime
  finalPainLevel  Int
  observations    String?
  patientResponse String
  phaseNumber     Int
  procedures      String[]
  voiceNotes      Json?
  deletedAt       DateTime?
  status          String         @default("DRAFT")
  photos          SessionPhoto[]
  clinicalCase    ClinicalCase   @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)
  therapist       User           @relation(fields: [therapistId], references: [id])

  @@map("treatment_sessions")
}

model SessionPhoto {
  id         String           @id @default(cuid())
  sessionId  String
  storageKey String
  caption    String?          @db.VarChar(140)
  capturedAt DateTime
  createdAt  DateTime         @default(now())
  session    TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_photos")
}

model Footprint {
  id           String     @id @default(cuid())
  type         String
  date         DateTime
  url          String
  analysis     Json?
  comparison   Json?
  evaluationId String
  side         String     @default("unknown")
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@map("footprints")
}

model PostureVideo {
  id           String     @id @default(cuid())
  type         String
  date         DateTime
  url          String
  duration     Int
  observations String
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@map("posture_videos")
}

model Insole {
  id             String       @id @default(cuid())
  type           String
  material       String
  features       Json?
  clinicalCaseId String
  clinicalCase   ClinicalCase @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)

  @@map("insoles")
}

model Session {
  id          String   @id @default(cuid())
  patientId   String
  therapistId String
  notes       String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  status      String   @default("DRAFT")
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist   User     @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Document {
  id         String      @id @default(uuid())
  title      String
  author     String?
  filePath   String      @unique
  createdAt  DateTime    @default(now())
  metadata   Json?
  embeddings Embedding[]

  @@map("documents")
}

model Embedding {
  id         String                @id @default(uuid())
  content    String
  vector     Unsupported("vector")
  pageNumber Int
  documentId String
  document   Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("embeddings")
}
