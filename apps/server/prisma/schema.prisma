generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  role              String             @default("THERAPIST")
  createdAt         DateTime           @default(now())
  pinHash           String?
  clinicName        String?
  licenseNumber     String?
  phone             String?
  profilePhotoUrl   String?
  specialty         String?
  yearsExperience   Int?
  patients          Patient[]
  sessions          Session[]
  treatmentSessions TreatmentSession[]
  aiAnalyses        AiAnalysis[]

  @@index([email])
  @@map("users")
}

model Patient {
  id                    String         @id @default(cuid())
  email                 String?
  therapistId           String
  deletedAt             DateTime?
  birthDate             DateTime
  createdAt             DateTime       @default(now())
  gender                String?
  isActive              Boolean        @default(true)
  name                  String
  occupation            String
  phone                 String
  previousOccupation    String?
  emergencyContact      Json?
  medicalFlags          String[]
  referralSource        String?
  medicalFlagsOther     String?
  referralSourceDetails String?
  clinicalCases         ClinicalCase[]
  therapist             User           @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  sessions              Session[]

  @@index([name])
  @@map("patients")
}

model ClinicalCase {
  id                      String             @id @default(cuid())
  patientId               String
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  consultationReason      String
  endDate                 DateTime?
  initialMedicalDiagnosis String?
  pathologicalHistory     Json?
  pharmacologicalHistory  String?
  startDate               DateTime
  status                  String
  title                   String
  patient                 Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  evaluations             Evaluation[]
  insoles                 Insole[]
  treatmentPlan           TreatmentPlan?
  treatmentSessions       TreatmentSession[]
  aiAnalyses              AiAnalysis[]

  @@map("clinical_cases")
}

model Evaluation {
  id              String         @id @default(cuid())
  clinicalCaseId  String
  avdEvaluation   Json
  date            DateTime
  diagnosis       Json
  orthopedicTests Json
  painScale       Json
  posturogram     Json
  voiceNotes      Json?
  type            String
  clinicalCase    ClinicalCase   @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)
  footprints      Footprint[]
  postureVideos   PostureVideo[]

  @@map("evaluations")
}

model TreatmentPlan {
  id             String                  @id @default(cuid())
  clinicalCaseId String                  @unique
  createdAt      DateTime                @default(now())
  insoleSnapshot Json?
  objectives     Json
  phases         Json
  clinicalCase   ClinicalCase            @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)
  protocols      TreatmentPlanProtocol[]

  @@map("treatment_plans")
}

model TreatmentSession {
  id              String         @id @default(cuid())
  clinicalCaseId  String
  therapistId     String
  createdAt       DateTime       @default(now())
  date            DateTime
  finalPainLevel  Int
  observations    String?
  patientResponse String
  phaseNumber     Int
  procedures      String[]
  voiceNotes      Json?
  deletedAt       DateTime?
  status          String         @default("DRAFT")
  photos          SessionPhoto[]
  clinicalCase    ClinicalCase   @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)
  therapist       User           @relation(fields: [therapistId], references: [id])

  @@map("treatment_sessions")
}

model SessionPhoto {
  id         String           @id @default(cuid())
  sessionId  String
  storageKey String
  caption    String?          @db.VarChar(140)
  capturedAt DateTime
  createdAt  DateTime         @default(now())
  session    TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_photos")
}

model Footprint {
  id           String     @id @default(cuid())
  type         String
  date         DateTime
  url          String
  analysis     Json?
  comparison   Json?
  evaluationId String
  side         String     @default("unknown")
  analyzedAt   DateTime?
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@map("footprints")
}

model PostureVideo {
  id           String     @id @default(cuid())
  type         String
  date         DateTime
  url          String
  duration     Int
  observations String
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@map("posture_videos")
}

model Insole {
  id             String       @id @default(cuid())
  type           String
  material       String
  features       Json?
  clinicalCaseId String
  clinicalCase   ClinicalCase @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)

  @@map("insoles")
}

model Session {
  id          String   @id @default(cuid())
  patientId   String
  therapistId String
  notes       String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  status      String   @default("DRAFT")
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist   User     @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum Archetype {
  PRACTICAL
  ACADEMIC
  ATLAS
  CASE_STUDY
  GENERAL
}

model Document {
  id         String      @id @default(uuid()) @db.Uuid
  title      String
  author     String?
  filePath   String      @unique
  archetype  Archetype   @default(GENERAL)
  createdAt  DateTime    @default(now())
  metadata   Json?
  embeddings Embedding[]
  protocols  Protocol[]

  @@map("documents")
}

enum ChunkType {
  NARRATIVE
  INDEX
  TOC
  REFERENCES
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Embedding {
  id            String                @id @default(uuid()) @db.Uuid
  content       String
  vector        Unsupported("vector")
  pageNumber    Int
  chunkType     ChunkType             @default(NARRATIVE)
  isExcluded    Boolean               @default(false)
  sectionType   String?
  documentId    String                @db.Uuid
  parentContent String?
  parentId      String?               @db.Uuid
  document      Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent        Embedding?            @relation("ParentChild", fields: [parentId], references: [id])
  children      Embedding[]           @relation("ParentChild")

  @@index([vector])
  @@map("embeddings")
}

model AiAnalysis {
  id             String       @id @default(cuid())
  clinicalCaseId String
  therapistId     String
  result         Json
  createdAt      DateTime     @default(now())
  clinicalCase   ClinicalCase @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)
  therapist      User         @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  feedbacks      AiFeedback[]

  @@index([clinicalCaseId])
  @@map("ai_analyses")
}

model AiFeedback {
  id              String     @id @default(cuid())
  aiAnalysisId    String
  suggestionIndex Int
  isPositive      Boolean
  comment         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  aiAnalysis      AiAnalysis @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)

  @@unique([aiAnalysisId, suggestionIndex])
  @@map("ai_feedbacks")
}

// =============================================================================
// Biblioteca Médica (Medical Library)
// =============================================================================

model ClinicalCategory {
  id          String     @id @default(cuid())
  name        String
  description String
  icon        String
  createdAt   DateTime   @default(now())
  protocols   Protocol[]

  @@map("clinical_categories")
}

model Protocol {
  id            String               @id @default(cuid())
  title         String
  categoryId    String
  definition    String
  rationale     String
  procedure     String[]
  tags          String[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  documentId    String?              @db.Uuid
  category      ClinicalCategory     @relation(fields: [categoryId], references: [id])
  document      Document?            @relation(fields: [documentId], references: [id])
  references    ProtocolReference[]
  treatmentPlanProtocols TreatmentPlanProtocol[]

  @@index([categoryId])
  @@map("protocols")
}

model BibliographicReference {
  id               String              @id @default(cuid())
  author           String
  year             Int
  title            String
  source           String
  originalLanguage String              @default("es")
  summaryEs        String
  originalText     String?
  url              String?
  createdAt        DateTime            @default(now())
  protocols        ProtocolReference[]

  @@map("bibliographic_references")
}

model ProtocolReference {
  protocolId  String
  referenceId String
  protocol    Protocol               @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  reference   BibliographicReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@id([protocolId, referenceId])
  @@map("protocol_references")
}

model AnatomicalDiagram {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String
  createdAt   DateTime @default(now())

  @@map("anatomical_diagrams")
}

model TreatmentPlanProtocol {
  treatmentPlanId String
  protocolId      String
  addedAt         DateTime      @default(now())
  notes           String?
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  protocol        Protocol      @relation(fields: [protocolId], references: [id])

  @@id([treatmentPlanId, protocolId])
  @@map("treatment_plan_protocols")
}
