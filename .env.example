#############################################
# DATABASE (Used by Docker Compose + Server)
#############################################
POSTGRES_USER=physio_user
POSTGRES_PASSWORD=physio_password_change_me
POSTGRES_DB=physio_db
POSTGRES_PORT=5432

# Full connection string (server reads this)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

#############################################
# STORAGE (MinIO - Used by Docker + Server)
#############################################
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=physio-media
MINIO_PUBLIC_ENDPOINT=http://localhost:9000


# Server uses these
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}

#############################################
# REDIS (Optional - for future caching)
#############################################
REDIS_PORT=6379

#############################################
# JWT AUTHENTICATION
#############################################
JWT_SECRET=change-this-super-secret-key-in-production-min-32-chars
JWT_EXPIRATION=7d

#############################################
# AI SERVICES (Phase 1 & 3)
#############################################
# Groq (Whisper for transcription - Phase 1)
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3
WHISPER_LANGUAGE=es
WHISPER_TIMEOUT=5000
WHISPER_MAX_RETRIES=5

# Google Gemini (Vision - Phase 3, AI Analysis - Phase 14)
GOOGLE_API_KEY=sdfsdfsdfsdf
GEMINI_MODEL=gemini-1.5-pro

# AI Analysis Agent (Phase 14)
AI_MODEL=gemini-3-flash-preview
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096

# OpenAI (Alternative for embeddings - Phase 3)
# OPENAI_API_KEY=

# HyDE (Hypothetical Document Embeddings) - Phase 16
ENABLE_HYDE=false

#############################################
# APPLICATION CONFIG
#############################################
NODE_ENV=development
SERVER_PORT=3000
CLIENT_PORT=5173

# URLs
FRONTEND_URL=http://localhost:${CLIENT_PORT}
BACKEND_URL=http://localhost:${SERVER_PORT}

#############################################
# DEPLOYMENT CONFIGURATION (Production Only)
#############################################
# Domain for Mamirri App (used by Caddy)
# Example: mamirri.figuedmundo.com
MAMIRRI_DOMAIN=mamirri.localhost

# Optional: Separate API subdomain (only if using Option B in Caddyfile)
# MAMIRRI_API_DOMAIN=mamirri-api.figuedmundo.com

# Server host for production (used by backend to generate URLs)
SERVER_HOST=${MAMIRRI_DOMAIN}

#############################################
# SECURITY
#############################################
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

#############################################
# LOGGING (Robust Logging System)
#############################################
# Log level: debug | verbose | info | warn | error | fatal
# RECOMMENDATION FOR PRODUCTION: Set to 'warn' or 'error' to reduce log volume
# - 'debug': Everything (development only, huge files)
# - 'info': Normal operations + errors (default, moderate files)
# - 'warn': Warnings and errors only (production recommended, small files)
# - 'error': Errors only (minimal files)
LOG_LEVEL=info

# Log format: json | pretty
LOG_FORMAT=pretty

# Log output: stdout | console
LOG_OUTPUT=console

# Service identification
SERVICE_NAME=mamirri-server
VERSION=0.0.1

# Frontend Logging
VITE_LOG_LEVEL=debug

#############################################
# SENTRY ERROR MONITORING (Optional but Recommended)
#############################################
# Get your DSN from: https://sentry.io
# Free tier: 5,000 errors/month
# Leave empty to disable Sentry
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx

# Application version for Sentry releases
VITE_APP_VERSION=1.0.0

#############################################
# OPTIONAL: AWS S3 (Alternative to MinIO)
#############################################
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=physio-media-prod
# AWS_REGION=eu-west-1

#############################################
# BACKUP CONFIGURATION
#############################################
# Encryption key for GPG symmetric encryption of backups
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=change-this-to-random-32-byte-string

# Directory where backups are stored on the server
# Default: /var/backups/physio
BACKUP_DIR=/var/backups/physio

# Number of days to keep backups before deletion
# Default: 7
BACKUP_RETENTION_DAYS=7

# Cohere Rerank API Key (for RAG reranking)
COHERE_API_KEY=your-cohere-api-key
