#############################################
# DATABASE (Used by Docker Compose + Server)
#############################################
POSTGRES_USER=physio_user
POSTGRES_PASSWORD=physio_password_change_me
POSTGRES_DB=physio_db
POSTGRES_PORT=5432

# Full connection string (server reads this)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

#############################################
# STORAGE (MinIO - Used by Docker + Server)
#############################################
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=physio-media

# Server uses these
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}

#############################################
# REDIS (Optional - for future caching)
#############################################
REDIS_PORT=6379

#############################################
# JWT AUTHENTICATION
#############################################
JWT_SECRET=change-this-super-secret-key-in-production-min-32-chars
JWT_EXPIRATION=7d

#############################################
# AI SERVICES (Phase 1 & 3)
#############################################
# Groq (Whisper for transcription - Phase 1)
GROQ_API_KEY=

# Google Gemini (Vision - Phase 3)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# OpenAI (Alternative for embeddings - Phase 3)
# OPENAI_API_KEY=

#############################################
# APPLICATION CONFIG
#############################################
NODE_ENV=development
SERVER_PORT=3000
CLIENT_PORT=5173

# URLs
FRONTEND_URL=http://localhost:${CLIENT_PORT}
BACKEND_URL=http://localhost:${SERVER_PORT}

#############################################
# SECURITY
#############################################
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

#############################################
# OPTIONAL: AWS S3 (Alternative to MinIO)
#############################################
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=physio-media-prod
# AWS_REGION=eu-west-1

#############################################
# BACKUP CONFIGURATION
#############################################
# Encryption key for GPG symmetric encryption of backups
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=change-this-to-random-32-byte-string

# Directory where backups are stored on the server
# Default: /var/backups/physio
BACKUP_DIR=/var/backups/physio

# Number of days to keep backups before deletion
# Default: 7
BACKUP_RETENTION_DAYS=7
