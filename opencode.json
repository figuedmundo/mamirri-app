{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "markitdown": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "markitdown-mcp"
      ]
    },
    "tavily": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "tavily-mcp"
      ],
      "environment": {
        "TAVILY_API_KEY": "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"
      }
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "z.ai-web-search-sse": {
      "type": "remote",
      "enabled": true,
      "url": "https://api.z.ai/api/mcp/web_search/sse?Authorization=2abc7127803b4c66b16f73158aca25b5.yVVpgpSFyqAVdod4"
    }
  }
}