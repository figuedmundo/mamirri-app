      "headers": {
        "Authorization": "Bearer 2abc7127803b4c66b16f73158aca25b5.yVVpgpSFyqAVdod4"
      }
    },
    "web-reader": {
      "enabled": true,
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer 2abc7127803b4c66b16f73158aca25b5.yVVpgpSFyqAVdod4"
      }
    },
    "zread": {
      "enabled": false,
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer 2abc7127803b4c66b16f73158aca25b5.yVVpgpSFyqAVdod4"
      }
    },
    "zai-vision": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
